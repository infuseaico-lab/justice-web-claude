# Apache / cPanel hosting configuration
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS and the bare domain
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Old URLs -> new URLs (add more during content migration)
  RewriteRule ^contact-us/?$ /contact/ [R=301,L]
  RewriteRule ^about-us/?$ /about/ [R=301,L]
  RewriteRule ^privacy/?$ /privacy-policy/ [R=301,L]
  RewriteRule ^hvac/?$ /services/hvac-heat-pumps/ [R=301,L]
  RewriteRule ^heat-pumps/?$ /services/hvac-heat-pumps/ [R=301,L]
  RewriteRule ^water-heaters/?$ /services/water-heating/ [R=301,L]
  RewriteRule ^led-lighting/?$ /services/led-lighting-retrofits/ [R=301,L]
  RewriteRule ^turf-replacement/?$ /services/turf-replacement/ [R=301,L]
  RewriteRule ^water-conservation/?$ /services/water-conservation/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js|svg|png|ico|webmanifest)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain application/manifest+json
</IfModule>

AddType image/svg+xml .svg
AddType application/manifest+json .webmanifest
